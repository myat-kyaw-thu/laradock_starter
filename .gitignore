# Laravel source (mounted as volume, managed separately)
src/
!src/.gitkeep

# Auto-generated project Caddy configs (keep default.caddyfile and .gitkeep)
docker/frankenphp/conf.d/*.caddyfile
!docker/frankenphp/conf.d/default.caddyfile
!docker/frankenphp/conf.d/.gitkeep

# Real env files — never commit these
.env
.env.docker

# Keep the example files — these are safe to commit
!.env.docker.example

# Logs (added in a later step)
logs/

# OS
.DS_Store
Thumbs.db
